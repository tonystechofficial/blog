---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { TRACKS } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { minutes?: number };

const { title, description, pubDate, updatedDate, track, tags, minutes } = Astro.props;
const trackLabel = TRACKS[track].label;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} · Tony Duong`} description={description} type="article" />
	</head>
	<body>
		<Header />
		<main class="wrap">
			<article>
				<p class="meta">
					<FormattedDate date={pubDate} />
					<span aria-hidden="true"> · </span>
					<a href={`/#${track}`}>{trackLabel}</a>
					{minutes && (
						<>
							<span aria-hidden="true"> · </span>
							<span>{minutes} min read</span>
						</>
					)}
				</p>
				<h1>{title}</h1>
				<p class="lead">{description}</p>
				<div class="prose">
					<slot />
				</div>
				<footer class="post-footer">
					{tags.length > 0 && (
						<p class="meta tags">
							{tags.map((t) => (
								<span class="tag">#{t}</span>
							))}
						</p>
					)}
					{updatedDate && (
						<p class="meta">
							Updated <FormattedDate date={updatedDate} />
						</p>
					)}
					<p class="note">
						Dated by when the work happened, then edited for publication.
						<a href="/about/#how">How these notes are made.</a>
					</p>
					<p class="back"><a href="/blog/">All writing</a></p>
				</footer>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	article .meta {
		margin-bottom: 0.9rem;
	}
	article h1 {
		margin-bottom: 0.8rem;
	}
	article .lead {
		margin-bottom: 2rem;
	}
	.post-footer {
		margin-top: 3rem;
		padding-top: 1.2rem;
		border-top: 1px solid var(--rule);
	}
	.tags {
		display: flex;
		gap: 0.8rem;
		flex-wrap: wrap;
	}
	.note {
		font-size: 0.95rem;
		color: var(--ink-3);
		margin-top: 0.6rem;
	}
	.back {
		font-family: var(--font-ui);
		font-size: 0.95rem;
	}
</style>
