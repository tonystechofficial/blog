---
import { type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';
import { getPosts } from '../../../i18n';

export async function getStaticPaths() {
	const posts = await getPosts('fr');
	const english = new Set((await getPosts('en')).map((p) => p.id));
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, alternate: english.has(post.id) },
	}));
}
type Props = { post: CollectionEntry<'blogFr'>; alternate: boolean };

const { post, alternate } = Astro.props;
const { Content } = await render(post);
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));
---

<BlogPost {...post.data} minutes={minutes} alternate={alternate}>
	<Content />
</BlogPost>
