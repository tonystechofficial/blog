---
// Home page, shared by / and /fr/.
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { TRACK_ORDER } from '../consts';
import { SITE, UI, asLang, getPosts, localize, tracks } from '../i18n';

const lang = asLang(Astro.currentLocale);
const t = UI[lang];
const posts = await getPosts(lang);
const byTrack = TRACK_ORDER.map((track) => ({
	track,
	...tracks(lang)[track],
	posts: posts.filter((p) => p.data.track === track),
})).filter((g) => g.posts.length > 0);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={SITE[lang].title} description={SITE[lang].description} />
	</head>
	<body>
		<Header />
		<main class="wrap">
			<section class="intro">
				<h1>{t.homeTitle}</h1>
				<p class="lead">{t.homeLead}</p>
				<p class="meta">
					{`${posts.length} ${t.notes}`} · <a href={localize(lang, '/about/')}>{t.aboutMe}</a> ·
					<a href={localize(lang, '/rss.xml')}>rss</a>
				</p>
			</section>

			{byTrack.map((g) => (
				<section class="track" id={g.track}>
					<p class="eyebrow">{g.label}</p>
					<p class="blurb">{g.blurb}</p>
					<ol class="posts">
						{g.posts.map((post) => (
							<li>
								<p class="title"><a href={localize(lang, `/blog/${post.id}/`)}>{post.data.title}</a></p>
								<p class="meta"><FormattedDate date={post.data.pubDate} /></p>
								<p class="desc">{post.data.description}</p>
							</li>
						))}
					</ol>
				</section>
			))}
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		margin-bottom: 2.5rem;
	}
	.intro h1 {
		font-size: 2.2rem;
		margin-bottom: 1rem;
	}
	.track {
		margin-top: 2.6rem;
	}
	.blurb {
		color: var(--ink-2);
		margin-bottom: 0.9rem;
	}
</style>
