---
import { AUTHOR, GITHUB_URL } from '../consts';
import { LANGS, SITE, UI, asLang, localize, unlocalize } from '../i18n';
import HeaderLink from './HeaderLink.astro';

interface Props {
	/** False when this page has no version in the other language: the switch then leads to that language's home. */
	alternate?: boolean;
}

const { alternate = true } = Astro.props;
const lang = asLang(Astro.currentLocale);
const t = UI[lang];
const path = unlocalize(Astro.url.pathname);
const switchHref = (to: typeof lang) => localize(to, alternate ? path : '/');
---

<header>
	<nav class="wrap">
		<a class="brand" href={localize(lang, '/')}>
			<span class="name">{AUTHOR}</span>
			<span class="sub">{SITE[lang].sub}</span>
		</a>
		<div class="links">
			<HeaderLink href={localize(lang, '/blog/')}>{t.writing}</HeaderLink>
			<HeaderLink href={localize(lang, '/about/')}>{t.about}</HeaderLink>
			<a href={localize(lang, '/rss.xml')}>RSS</a>
			<a href={GITHUB_URL} rel="me">GitHub</a>
			<span class="lang" role="group" aria-label={t.language}>
				{LANGS.map((l, i) => (
					<>
						{i > 0 && <span class="sep" aria-hidden="true">/</span>}
						{l === lang ? (
							<span class="current" aria-current="true">{l.toUpperCase()}</span>
						) : (
							<a href={switchHref(l)} hreflang={l} lang={l}>
								{l.toUpperCase()}
							</a>
						)}
					</>
				))}
			</span>
		</div>
	</nav>
</header>

<style>
	header {
		border-bottom: 1px solid var(--rule);
	}
	nav {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		padding-block: 1.1rem;
	}
	.brand {
		text-decoration: none;
		color: var(--ink);
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
	}
	.name {
		font-family: var(--font-ui);
		font-weight: 600;
		font-size: 1.05rem;
	}
	.sub {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--ink-3);
	}
	.links {
		display: flex;
		align-items: baseline;
		gap: 1.1rem;
		flex-wrap: wrap;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.03em;
	}
	.links a {
		color: var(--ink-2);
		text-decoration: none;
		padding-bottom: 0.15rem;
		border-bottom: 1px solid transparent;
	}
	.links a:hover,
	.links :global(a.active) {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}
	.lang {
		display: inline-flex;
		align-items: baseline;
		gap: 0.35rem;
		padding-left: 1.1rem;
		border-left: 1px solid var(--rule);
	}
	.lang .current {
		color: var(--ink);
		font-weight: 500;
	}
	.lang .sep {
		color: var(--ink-3);
	}
</style>
